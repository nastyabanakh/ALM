  {
    id: 'stage-02',
    num: '02//',
    stageTitle: 'STAGE 02',
    title: 'Scope of work',
    desc: 'Complete structure teardown, slope stabilization, tailored engineering permits, full ground-up build, custom interior finishes, and final city sign-offs.',
    image: '/assets/section-09/breakdown-02.webp'
  },
  {
    id: 'stage-03',
    num: '03//',
    stageTitle: 'STAGE 03',
    title: 'Key decisions',
    desc: 'Integrated 10-foot floor-to-ceiling glass, continuous white oak cabinetry, a cantilevered primary terrace, and an understated exterior blend of dark metal and cedar.',
    image: '/assets/section-09/breakdown-card-03.webp'
