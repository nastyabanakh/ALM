const stages: BreakdownStage[] = [
  {
    id: 'stage-01',
    num: '01//',
    stageTitle: 'STAGE 01',
    title: 'Starting situation',
    desc: 'An outdated 1960s rambler on a steep, heavily wooded Bellevue lot. The owners wanted an open, light-filled modern home that embraced the tree canopy without losing functional yard space.',
    image: '/assets/section-09/breakdown-card-01.webp'
