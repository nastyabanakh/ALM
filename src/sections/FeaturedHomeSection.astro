                <div class="featured-home-section__v-divider" aria-hidden="true"></div>
              )}
            </article>
          ))}
        </div>
      </div>

    </div>
  </div>

</section>

<script>
  function initBreakdownStickyScroll() {
    const outer = document.getElementById('project-breakdown-outer');
    const track = document.getElementById('project-breakdown-track');
    if (!outer || !track) return;

    const cards = Array.from(track.querySelectorAll<HTMLElement>('.featured-home-section__card'));
    if (!cards.length) return;

    let ticking = false;

    function update() {
      ticking = false;
      const rect = outer.getBoundingClientRect();
      const totalScrollable = outer.offsetHeight - window.innerHeight;
      if (totalScrollable <= 0) return;

      // Fractional progress from 0.0 to 1.0
      const scrolled = -rect.top;
      const progress = Math.max(0, Math.min(1, scrolled / totalScrollable));
      const stageProgress = progress * (cards.length - 1); // 0.0 to 3.0

      // Dynamic rem measurement
      const rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
      const minW = 307 * rem;
      const minH = 295 * rem;
      const cardGap = 60 * rem;
      const contentW = 311 * rem;
      const dividerW = 1 * rem;
      
      // Compute available height in sticky container (100vh - 40rem top - 40rem bottom)
      const viewport = track.parentElement;
      const availableH = viewport ? viewport.clientHeight : (window.innerHeight - 80 * rem);
      const maxH = Math.max(minH, availableH);
      const maxW = Math.round(maxH * (668 / 698));

      // Unit width of a card unit in track when small: photo + gap + content + gap + divider + gap
      const baseCardUnit = minW + cardGap + contentW + cardGap + dividerW + cardGap;

      cards.forEach((card, idx) => {
        const media = card.querySelector<HTMLElement>('.featured-home-section__card-media');
        const content = card.querySelector<HTMLElement>('.featured-home-section__card-content');
        
        // Distance to the active fractional point
        const dist = Math.abs(stageProgress - idx);
        // Weight is 1 when exactly active, 0 when >= 1 step away
        const weight = Math.max(0, Math.min(1, 1 - dist));

        // Smooth width & height interpolation
        const currentW = minW + (maxW - minW) * weight;
        const currentH = minH + (maxH - minH) * weight;

        if (media) {
          media.style.width = `${currentW}px`;
          media.style.height = `${currentH}px`;
        }

        if (content) {
          content.style.opacity = `${0.35 + 0.65 * weight}`;
          content.style.transform = `translate3d(0, ${(1 - weight) * 10}px, 0)`;
        }
      });

      // Shift track smoothly so active card is anchored
      const trackX = stageProgress * baseCardUnit;
      track.style.transform = `translate3d(-${trackX}px, 0, 0)`;
    }

    function onScrollOrResize() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    window.addEventListener('scroll', onScrollOrResize, { passive: true });
    window.addEventListener('resize', onScrollOrResize, { passive: true });
    update();
  }

  // -------------------------------------------------------------
  // Kitchen Photo Parallax Effect (Section 09)
  // -------------------------------------------------------------
  function initKitchenPhotoParallax() {
    const heroMedia = document.querySelector<HTMLElement>('.featured-home-section__hero-media');
    const heroImg = document.querySelector<HTMLElement>('.featured-home-section__hero-img');
    if (!heroMedia || !heroImg) return;

    let ticking = false;

    function updateParallax() {
      ticking = false;
      const rect = heroMedia.getBoundingClientRect();
      const windowHeight = window.innerHeight;

      // Only calculate when element is in or near viewport
      if (rect.bottom > -200 && rect.top < windowHeight + 200) {
        // Progress from 0 (when top of media reaches bottom of viewport)
        // to 1 (when bottom of media reaches top of viewport)
        const totalDistance = windowHeight + rect.height;
        const currentDistance = windowHeight - rect.top;
        const progress = Math.max(0, Math.min(1, currentDistance / totalDistance));

        // Parallax offset: shift smoothly from -12% to +12% with scale 1.08
        const yOffsetPercent = -12 + progress * 24; // from -12% to +12%
        heroImg.style.transform = `translate3d(0, ${yOffsetPercent.toFixed(2)}%, 0) scale(1.08)`;
      }
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateParallax);
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    updateParallax();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initBreakdownStickyScroll();
      initKitchenPhotoParallax();
    });
  } else {
    initBreakdownStickyScroll();
    initKitchenPhotoParallax();
  }
</script>

