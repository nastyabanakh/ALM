    index: '03//',
    label: 'Starting point:',
    value: 'Full Teardown & Slope Stabilization'
  },
  {
    index: '04//',
    label: 'Home size:',
    value: '4,850 sq ft'
  },
  {
    index: '05//',
    label: 'Architectural style:',
    value: 'Pacific Northwest Contemporary'
