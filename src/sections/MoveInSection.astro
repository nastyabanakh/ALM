---
/**
 * MoveInSection.astro — Section 07: Move In After Handoff
 * Figma node 70:2431
 *
 * Layout:
 * — White header: sub-bar (07//), centered h2 title, centered description
 * — Photo collage (height: calc(100vh - 30rem)):
 *     - Left col  (~395rem): bathroom photo  → scrolls into view, then sticks
 *     - Center col (~234rem): 2 stacked photos + CTA button → same as left
 *     - Right col  (~787rem): living room panorama → sticky from the start
 * — White spec table below (5 rows: label + value)
 */
import ButtonComposite from '../components/ButtonComposite.astro';

interface SpecRow {
  label: string;
  value: string;
}

const specs: SpecRow[] = [
  { label: 'Surfaces & Envelope:', value: 'Interior walls, hardwood flooring, and exterior siding' },
  { label: 'Cabinetry & Kitchen:', value: 'Custom millwork, countertops, and agreed appliances' },
  { label: 'Bathrooms & Fixtures:', value: 'Designer plumbing, tilework, mirrors, and lighting' },
  { label: 'Mechanical Systems:', value: 'Fully connected HVAC, electrical, and plumbing' },
  { label: 'Permits & Closeout:', value: 'Passed city inspections and final sign-off for move-in' },
];
---

<section class="move-in" id="move-in" aria-label="Move In After Handoff">

  <!-- ─── Top Header (White) ─── -->
  <div class="move-in__header">
    <!-- Sub-bar -->
    <div class="move-in__bar">
      <div class="move-in__bar-inner">
        <span class="move-in__bullet" aria-hidden="true"></span>
        <span class="move-in__bar-label text-m text-opacity-subtle">Move In After Handoff</span>
      </div>
      <span class="move-in__bar-index text-m text-opacity-subtle">07//</span>
    </div>
    <div class="move-in__bar-divider" aria-hidden="true"></div>

    <!-- Title + Description -->
    <div class="move-in__header-content">
      <h2 class="move-in__title h2 text-color-dark">
        MOVE IN AFTER<br />HANDOFF, NOT AFTER<br />MORE CONSTRUCTION
      </h2>
      <p class="move-in__desc text-m">
        Every major finish is complete before you turn<br />
        the key. We deliver homes ready for living, with<br />
        all interior, exterior, and mechanical systems<br />
        fully resolved.
      </p>
    </div>
  </div>

  <!-- ─── Collage: Scroll Track ─── -->
  <div class="move-in__track" id="move-in-track">
    <div class="move-in__sticky" id="move-in-sticky">

      <!-- RIGHT: Sticky panorama (always in view) -->
      <div class="move-in__col-right">
        <img
          src="/assets/section-10/collage-right.webp"
          alt="Open plan living and dining area in custom ALM home"
          class="move-in__photo"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- LEFT + CENTER: Slide in from below during scroll -->
      <div class="move-in__col-lc" id="move-in-lc">

        <!-- Left: Large bathroom photo -->
        <div class="move-in__col-left">
          <img
            src="/assets/section-10/collage-left.webp"
            alt="Custom bathroom with stone vanity and pendant lighting in ALM home"
            class="move-in__photo"
            loading="lazy"
            decoding="async"
          />
        </div>

        <!-- Center: Two stacked photos + CTA -->
        <div class="move-in__col-center">
          <div class="move-in__center-top">
            <img
              src="/assets/section-10/collage-center-top.webp"
              alt="Home office with custom built-ins in ALM home"
              class="move-in__photo"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="move-in__center-bottom">
            <img
              src="/assets/section-10/collage-center-bottom.webp"
              alt="Custom kitchen with premium appliances in ALM home"
              class="move-in__photo"
              loading="lazy"
              decoding="async"
            />
            <!-- CTA Button overlaid at bottom of center column -->
            <div class="move-in__cta">
              <ButtonComposite text="SCHEDULE A CONSULTATION" href="#contact" fullWidth={true} />
            </div>
          </div>
        </div>

      </div><!-- /col-lc -->
    </div><!-- /sticky -->
  </div><!-- /track -->

  <!-- ─── Spec Table (White Background) ─── -->
  <div class="move-in__specs">
    {specs.map((row) => (
      <div class="move-in__spec-row">
        <span class="move-in__spec-label text-xs">{row.label}</span>
        <span class="move-in__spec-value text-m">{row.value}</span>
      </div>
    ))}
  </div>

</section>

<script>
  (function () {
    const track   = document.getElementById('move-in-track');
    const sticky  = document.getElementById('move-in-sticky');
    const lc      = document.getElementById('move-in-lc');
    if (!track || !sticky || !lc) return;

    // The left+center panel starts fully below the viewport and slides up
    const SLIDE_DISTANCE_VH = 0.40; // travels 40% of vh upward during scroll

    let rafId: number | null = null;
    let currentY = SLIDE_DISTANCE_VH * window.innerHeight;
    let targetY  = currentY;

    function lerp(a: number, b: number, t: number) {
      return a + (b - a) * t;
    }

    function onScroll() {
      const rect = track.getBoundingClientRect();
      const stickyH = sticky.offsetHeight;
      const trackH  = track.offsetHeight;

      // progress 0 → 1 as track scrolls through viewport
      const scrolled = -rect.top;
      const maxScroll = trackH - stickyH;
      const progress = Math.min(1, Math.max(0, scrolled / (maxScroll || 1)));

      // Left+center: slide from +slideDistance → 0
      const slide = window.innerHeight * SLIDE_DISTANCE_VH;
      targetY = slide * (1 - progress);

      if (rafId === null) {
        rafId = requestAnimationFrame(tick);
      }
    }

    function tick() {
      rafId = null;
      currentY = lerp(currentY, targetY, 0.10);
      lc.style.transform = `translateY(${currentY.toFixed(2)}px)`;

      // Keep ticking while still animating
      if (Math.abs(currentY - targetY) > 0.2) {
        rafId = requestAnimationFrame(tick);
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll(); // init
  })();
</script>

<style>
  /* ============================================================
     MOVE IN AFTER HANDOFF — Section 07
     Fluid REM Scaling: 1px Figma = 1rem CSS. Zero-px rule.
     Atomic longhand properties only.
     ============================================================ */

  .move-in {
    background-color: var(--bg-white);
    overflow-x: clip;
  }

  /* ─── Header ─── */
  .move-in__header {
    padding-top: var(--gap-t);
    padding-right: var(--gap-r);
    padding-bottom: 0;
    padding-left: var(--gap-r);
  }

  .move-in__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 12rem;
  }

  .move-in__bar-inner {
    display: flex;
    align-items: center;
    column-gap: var(--gap-2xs);
  }

  .move-in__bullet {
    display: block;
    width: 6rem;
    height: 6rem;
    background-color: var(--color-dark);
    flex-shrink: 0;
  }

  .move-in__bar-label {
    color: rgba(19, 19, 19, 0.5);
  }

  .move-in__bar-index {
    color: rgba(19, 19, 19, 0.5);
  }

  .move-in__bar-divider {
    width: 100%;
    height: 1rem;
    background-color: rgba(19, 19, 19, 0.15);
    margin-bottom: var(--gap-t);
  }

  .move-in__header-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-bottom: var(--gap-t);
    row-gap: var(--gap-s);
  }

  .move-in__title {
    color: var(--color-dark);
    line-height: 1.05;
  }

  .move-in__desc {
    color: rgba(19, 19, 19, 0.6);
    line-height: 1.5;
    max-width: 420rem;
  }

  /* ─── Scroll Track ─── */
  .move-in__track {
    /* Extra scroll height gives the slide-in animation time to play */
    height: calc((100vh - 30rem) + 40vh);
    position: relative;
  }

  .move-in__sticky {
    position: sticky;
    top: 15rem;
    height: calc(100vh - 30rem);
    display: flex;
    flex-direction: row;
    overflow: hidden;
    width: 100%;
  }

  /* ─── Right column (always in view, no JS transform) ─── */
  .move-in__col-right {
    flex: 1 1 0;
    min-width: 0;
    height: 100%;
    overflow: hidden;
  }

  /* ─── Left + Center panel (JS translateY) ─── */
  .move-in__col-lc {
    display: flex;
    flex-direction: row;
    width: 629rem;      /* 395 + 234 */
    flex-shrink: 0;
    height: 100%;
    will-change: transform;
  }

  /* ─── Left column ─── */
  .move-in__col-left {
    width: 395rem;
    flex-shrink: 0;
    height: 100%;
    overflow: hidden;
  }

  /* ─── Center column ─── */
  .move-in__col-center {
    width: 234rem;
    flex-shrink: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .move-in__center-top {
    flex: 1 1 0;
    overflow: hidden;
  }

  .move-in__center-bottom {
    flex: 1 1 0;
    overflow: hidden;
    position: relative;
  }

  /* CTA button overlaid at bottom of center column */
  .move-in__cta {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;
  }

  /* ─── All photos fill their containers ─── */
  .move-in__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* ─── Spec Table ─── */
  .move-in__specs {
    background-color: var(--bg-white);
    padding-top: var(--gap-t);
    padding-right: var(--gap-r);
    padding-bottom: var(--gap-t);
    padding-left: 50%;           /* right-aligned: labels start at midpoint */
    display: flex;
    flex-direction: column;
    row-gap: var(--gap-xs);
  }

  .move-in__spec-row {
    display: grid;
    grid-template-columns: 220rem 1fr;
    column-gap: var(--gap-p);
    align-items: baseline;
    padding-top: var(--gap-2xs);
    padding-bottom: var(--gap-2xs);
    border-bottom-width: 1rem;
    border-bottom-style: solid;
    border-bottom-color: rgba(19, 19, 19, 0.1);
  }

  .move-in__spec-label {
    color: rgba(19, 19, 19, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .move-in__spec-value {
    color: var(--color-dark);
    text-align: right;
  }

  /* ─── MOBILE ─── */
  @media (max-width: 479px) {
    .move-in__header {
      padding-top: var(--gap-l);
      padding-right: var(--gap-p);
      padding-left: var(--gap-p);
    }

    .move-in__header-content {
      align-items: flex-start;
      text-align: left;
    }

    .move-in__desc {
      max-width: 100%;
    }

    /* On mobile: stack columns vertically, no sticky, no slide */
    .move-in__track {
      height: auto;
    }

    .move-in__sticky {
      position: static;
      height: auto;
      flex-direction: column;
    }

    .move-in__col-right {
      width: 100%;
      height: 60vw;
    }

    .move-in__col-lc {
      width: 100%;
      flex-direction: column;
      height: auto;
      transform: none !important;
    }

    .move-in__col-left {
      width: 100%;
      height: 80vw;
    }

    .move-in__col-center {
      width: 100%;
      height: auto;
    }

    .move-in__center-top,
    .move-in__center-bottom {
      height: 60vw;
    }

    .move-in__cta {
      position: static;
    }

    .move-in__specs {
      padding-left: var(--gap-p);
      padding-right: var(--gap-p);
    }

    .move-in__spec-row {
      grid-template-columns: 1fr;
      row-gap: 4rem;
    }

    .move-in__spec-value {
      text-align: left;
    }
  }
</style>
