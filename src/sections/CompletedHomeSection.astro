---
/**
 * CompletedHomeSection.astro — Section 11: The Completed Home
 * Figma node 70:2431 / Frame 500 / Spacer node 203:265
 *
 * Requirements:
 * — Top gap between sections: 120rem (var(--space-l))
 * — Side padding: strictly 40rem on desktop (var(--gap-r))
 * — Sticky Collage viewport: calc(100vh - 100rem), top: 50rem (50rem top & bottom margin)
 * — Top clip: overflow: hidden on the sticky window ensures scrolling content never bleeds above
 * — Left column: Bathroom + Bedroom & Kitchen stack (no button)
 * — Right column: Living room photo -> scrolls up to reveal 5 specs rows + full-width CTA button (40rem gap)
 * — Perfect bottom alignment: When fully scrolled, bottom CTA aligns exactly with bottom edge of left column
 * — Smooth 60/120fps direct scroll synchronization (no lag jitter)
 */
import ButtonComposite from '../components/ButtonComposite.astro';

interface SpecItem {
  label: string;
  value: string;
}

const specs: SpecItem[] = [
  {
    label: 'SURFACES & ENVELOPE:',
    value: 'Interior walls, hardwood flooring, and exterior siding'
  },
  {
    label: 'CABINETRY & KITCHEN:',
    value: 'Custom millwork, countertops, and agreed appliances'
  },
  {
    label: 'BATHROOMS & FIXTURES:',
    value: 'Designer plumbing, tilework, mirrors, and lighting'
  },
  {
    label: 'MECHANICAL SYSTEMS:',
    value: 'Fully connected HVAC, electrical, and plumbing'
  },
  {
    label: 'PERMITS & CLOSEOUT:',
    value: 'Passed city inspections and final sign-off for move-in'
  }
];
---

<section class="completed-home" id="completed-home" aria-label="The Completed Home">
  <!-- Top 120rem Spacer -->
  <div class="completed-home__top-spacer" aria-hidden="true"></div>

  <div class="completed-home__container">

    <!-- 1. SUB-HEADER BAR -->
    <div class="completed-home__bar">
      <div class="completed-home__bar-main">
        <span class="completed-home__bullet" aria-hidden="true"></span>
        <span class="completed-home__bar-label text-m">The completed home</span>
      </div>
      <span class="completed-home__bar-index text-m">11//</span>
    </div>
    <div class="completed-home__divider" aria-hidden="true"></div>

    <!-- 2. SECTION HEADER (TITLE & DESCRIPTION) -->
    <div class="completed-home__header">
      <h2 class="completed-home__title h2">
        MOVE IN AFTER HANDOFF, NOT AFTER MORE CONSTRUCTION
      </h2>
      <p class="completed-home__desc text-m">
        Every major finish is complete before you turn the key. We deliver homes ready for living, with all interior, exterior, and mechanical systems fully resolved.
      </p>
    </div>

  </div>

  <!-- 3. SCROLL TRACK & STICKY CLIPPED COLLAGE -->
  <div class="completed-home__track" id="completed-home-track">
    <div class="completed-home__sticky-window" id="completed-home-sticky">
      <div class="completed-home__collage-grid">

        <!-- LEFT COLUMN: Bathroom + (Bedroom & Kitchen stack) -->
        <div class="completed-home__left">
          <!-- Bathroom (Full Height) -->
          <div class="completed-home__bathroom-box">
            <img
              src="/assets/section-10/bathroom.webp"
              alt="Designer custom bathroom with vanity and ambient lighting"
              class="completed-home__photo"
              loading="lazy"
              decoding="async"
            />
          </div>

          <!-- Stack: Bedroom (top) + Kitchen (bottom) — No Button -->
          <div class="completed-home__stack-box">
            <div class="completed-home__stack-top">
              <img
                src="/assets/section-10/bedroom.webp"
                alt="Custom home primary bedroom with modern chandelier"
                class="completed-home__photo"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="completed-home__stack-bottom">
              <img
                src="/assets/section-10/kitchen.webp"
                alt="High-end modern kitchen with integrated appliances"
                class="completed-home__photo"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN: Clipped window with scrolling content inside -->
        <div class="completed-home__right-window">
          <div class="completed-home__right-content" id="completed-home-right-content">
            <!-- Living Room Panorama (Exact viewport height) -->
            <div class="completed-home__living-box">
              <img
                src="/assets/section-10/living-room.webp"
                alt="Spacious living room with high ceilings and custom finishes"
                class="completed-home__photo"
                loading="lazy"
                decoding="async"
              />
            </div>

            <!-- Specifications List -->
            <div class="completed-home__specs-box">
              <div class="completed-home__specs">
                {specs.map((item) => (
                  <div class="completed-home__spec-row">
                    <span class="completed-home__spec-label text-m">{item.label}</span>
                    <span class="completed-home__spec-value text-m">{item.value}</span>
                  </div>
                ))}
              </div>

              <!-- Right Bottom Full-Width CTA (40rem top gap, aligns exactly with bottom edge) -->
              <div class="completed-home__right-cta">
                <ButtonComposite
                  text="SCHEDULE A CONSULTATION"
                  href="#contact"
                  variant="dark"
                  fullWidth={true}
                />
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

</section>

<script>
  function initCompletedHomeScroll() {
    const track = document.getElementById('completed-home-track');
    const sticky = document.getElementById('completed-home-sticky');
    const rightContent = document.getElementById('completed-home-right-content');

    if (!track || !sticky || !rightContent) return;

    let ticking = false;

    function update() {
      ticking = false;

      // Disabled on mobile viewports
      if (window.innerWidth <= 479) {
        rightContent.style.transform = '';
        return;
      }

      const rect = track.getBoundingClientRect();
      const trackHeight = track.offsetHeight;
      const stickyHeight = sticky.offsetHeight;
      const scrollableDistance = trackHeight - stickyHeight;

      if (scrollableDistance <= 0) return;

      const scrolled = -rect.top;
      const progress = Math.max(0, Math.min(1, scrolled / scrollableDistance));

      const maxTranslate = rightContent.scrollHeight - stickyHeight;
      const translateY = -progress * Math.max(0, maxTranslate);

      rightContent.style.transform = `translate3d(0, ${translateY.toFixed(2)}px, 0)`;
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCompletedHomeScroll);
  } else {
    initCompletedHomeScroll();
  }
</script>

<style>
  /* ============================================================
     THE COMPLETED HOME — SECTION 11
     Fluid REM Scaling: 1px Figma = 1rem CSS. Zero-px rule.
     Atomic longhand box model & positioning properties only.
     ============================================================ */

  .completed-home {
    background-color: var(--bg-white);
    position: relative;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: var(--gap-2xl);
    padding-left: 0;
    overflow-x: clip;
  }

  /* ─── 120rem Top Spacer (Figma node 203:265 Space/S) ─── */
  .completed-home__top-spacer {
    width: 100%;
    height: 120rem;
    background-color: var(--bg-white);
  }

  .completed-home__container {
    width: 100%;
    max-width: 1440rem;
    margin-top: 0;
    margin-right: auto;
    margin-bottom: 0;
    margin-left: auto;
    padding-top: 0;
    padding-right: 40rem;
    padding-bottom: 0;
    padding-left: 40rem;
  }

  /* ─── 1. Sub-Header Bar ─── */
  .completed-home__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: var(--gap-2xs);
    padding-left: 0;
  }

  .completed-home__bar-main {
    display: flex;
    align-items: center;
    column-gap: 9rem;
  }

  .completed-home__bullet {
    display: block;
    width: 6rem;
    height: 6rem;
    background-color: var(--color-dark);
    flex-shrink: 0;
  }

  .completed-home__bar-label {
    color: var(--color-dark);
    opacity: 0.5;
  }

  .completed-home__bar-index {
    color: var(--color-dark);
    opacity: 0.5;
  }

  .completed-home__divider {
    width: 100%;
    height: 1rem;
    background-color: rgba(19, 19, 19, 0.15);
    margin-top: var(--gap-2xs);
    margin-right: 0;
    margin-bottom: var(--gap-l);
    margin-left: 0;
  }

  /* ─── 2. Header (Title + Description) ─── */
  .completed-home__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-top: 0;
    margin-right: auto;
    margin-bottom: var(--gap-l);
    margin-left: auto;
    max-width: 516rem;
    row-gap: 19rem;
  }

  .completed-home__title {
    color: var(--color-dark);
    text-transform: uppercase;
    line-height: 1.05;
  }

  .completed-home__desc {
    color: var(--color-dark);
    opacity: 0.5;
    line-height: 1.4;
    max-width: 291rem;
  }

  /* ─── 3. Scroll Track & Sticky Clipped Viewport ─── */
  .completed-home__track {
    position: relative;
    width: 100%;
    /* Extra scroll height for smooth translation of specs and button */
    height: calc((100vh - 100rem) + 480rem);
  }

  .completed-home__sticky-window {
    position: sticky;
    top: 50rem;
    height: calc(100vh - 100rem);
    width: 100%;
    overflow: hidden;
  }

  .completed-home__collage-grid {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    column-gap: 12rem;
    width: 100%;
    max-width: 1440rem;
    height: 100%;
    margin-top: 0;
    margin-right: auto;
    margin-bottom: 0;
    margin-left: auto;
    padding-top: 0;
    padding-right: 40rem;
    padding-bottom: 0;
    padding-left: 40rem;
  }

  /* ─── Left Column (Fixed in the sticky window) ─── */
  .completed-home__left {
    flex: 1.15 1 0;
    min-width: 0;
    height: 100%;
    display: flex;
    flex-direction: row;
    column-gap: 12rem;
    overflow: hidden;
  }

  .completed-home__bathroom-box {
    flex: 1 1 0;
    min-width: 0;
    height: 100%;
    overflow: hidden;
    background-color: #8b8b8b;
  }

  .completed-home__stack-box {
    flex: 1 1 0;
    min-width: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    row-gap: 12rem;
  }

  .completed-home__stack-top {
    flex: 1 1 0;
    min-height: 1rem;
    overflow: hidden;
    background-color: #8b8b8b;
  }

  .completed-home__stack-bottom {
    flex: 1 1 0;
    min-height: 1rem;
    overflow: hidden;
    background-color: #8b8b8b;
  }

  /* ─── Right Column: Clipped Window & Scrolling Content ─── */
  .completed-home__right-window {
    flex: 1 1 0;
    min-width: 0;
    height: 100%;
    overflow: hidden;
    position: relative;
  }

  .completed-home__right-content {
    width: 100%;
    display: flex;
    flex-direction: column;
    will-change: transform;
  }

  .completed-home__living-box {
    width: 100%;
    height: calc(100vh - 100rem);
    overflow: hidden;
    background-color: #8b8b8b;
    flex-shrink: 0;
  }

  .completed-home__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* ─── Specifications Box ─── */
  .completed-home__specs-box {
    width: 100%;
    display: flex;
    flex-direction: column;
    padding-top: 40rem;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
  }

  .completed-home__specs {
    width: 100%;
    display: flex;
    flex-direction: column;
    row-gap: 12rem;
  }

  .completed-home__spec-row {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    justify-content: space-between;
    width: 100%;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 12rem;
    padding-left: 0;
    border-bottom-width: 1rem;
    border-bottom-style: solid;
    border-bottom-color: rgba(19, 19, 19, 0.15);
    column-gap: var(--gap-s);
  }

  .completed-home__spec-label {
    color: var(--color-dark);
    opacity: 0.5;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .completed-home__spec-value {
    color: var(--color-dark);
    text-align: right;
  }

  .completed-home__right-cta {
    width: 100%;
    margin-top: 40rem;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
  }

  /* ─── MOBILE ADAPTATION (max-width: 479px) ─── */
  @media (max-width: 479px) {
    .completed-home {
      padding-top: 0;
      padding-bottom: var(--gap-l);
    }

    .completed-home__top-spacer {
      height: 60rem;
    }

    .completed-home__container {
      width: 100%;
      padding-right: var(--gap-p);
      padding-left: var(--gap-p);
    }

    .completed-home__header {
      align-items: flex-start;
      text-align: left;
      max-width: 100%;
    }

    .completed-home__desc {
      max-width: 100%;
    }

    .completed-home__track {
      height: auto;
    }

    .completed-home__sticky-window {
      position: static;
      height: auto;
      overflow: visible;
    }

    .completed-home__collage-grid {
      flex-direction: column;
      height: auto;
      row-gap: var(--gap-m);
      padding-right: var(--gap-p);
      padding-left: var(--gap-p);
    }

    .completed-home__left {
      width: 100%;
      height: auto;
      flex-direction: column;
      row-gap: var(--gap-s);
    }

    .completed-home__bathroom-box {
      width: 100%;
      height: 75vw;
    }

    .completed-home__stack-box {
      width: 100%;
      height: auto;
      row-gap: var(--gap-s);
    }

    .completed-home__stack-top,
    .completed-home__stack-bottom {
      height: 55vw;
    }

    .completed-home__right-window {
      width: 100%;
      height: auto;
      overflow: visible;
    }

    .completed-home__right-content {
      transform: none !important;
    }

    .completed-home__living-box {
      width: 100%;
      height: 65vw;
    }

    .completed-home__specs-box {
      width: 100%;
      padding-top: var(--gap-s);
    }

    .completed-home__spec-row {
      flex-direction: column;
      align-items: flex-start;
      row-gap: 4rem;
    }

    .completed-home__spec-value {
      text-align: left;
    }
  }
</style>
