---
/**
 * FinishedStandardSection.astro
 * Section 05: The Finished Standard (Figma node 166:2231 / Frame 436)
 * "PREMIUM MEANS FINISHED DETAILS, NOT LEFT FOR LATER"
 * Includes responsive layout, fluid REM scaling, and interactive showcase tabs.
 */

interface ShowcaseItem {
  id: string;
  title: string;
  subtitle: string;
  cardTitle: string;
  image: string;
  active?: boolean;
}

const showcaseItems: ShowcaseItem[] = [
  {
    id: 'daily-layout',
    title: 'Daily<br />Layout',
    subtitle: 'Living, private, and outdoor spaces shaped for how your family actually lives.',
    cardTitle: 'Daily Layout',
    image: '/assets/section-05/daily-layout.webp',
    active: true
  },
  {
    id: 'turnkey-interiors',
    title: 'Turnkey<br />Interiors',
    subtitle: 'Cabinetry, fixtures, surfaces, and lighting delivered fully complete.',
    cardTitle: 'Turnkey Interiors',
    image: '/assets/section-05/turnkey-interiors.webp',
    active: false
  },
  {
    id: 'cohesive-finishes',
    title: 'Cohesive<br />Finishes',
    subtitle: 'Key finishes are chosen with the full interior and exterior in view.',
    cardTitle: 'Cohesive Finishes',
    image: '/assets/section-05/cohesive-finishes.webp',
    active: false
  },
  {
    id: 'outdoor-living',
    title: 'Outdoor<br />Living',
    subtitle: 'Facades, glazing, and terraces planned together—never as afterthoughts.',
    cardTitle: 'Outdoor Living',
    image: '/assets/section-05/outdoor-living.webp',
    active: false
  }
];
---

<section class="finished-standard" id="finished-standard" aria-label="The Finished Standard">
  <!-- Top Sub-Header Bar & Divider (Frame 437 / Frame 433) -->
  <div class="finished-standard__bar">
    <div class="finished-standard__bar-left">
      <span class="finished-standard__bullet" aria-hidden="true"></span>
      <span class="finished-standard__bar-title">
        The finished standard
      </span>
    </div>
    <span class="finished-standard__bar-index" aria-hidden="true">
      05//
    </span>
  </div>

  <div class="finished-standard__divider" aria-hidden="true"></div>

  <!-- Centered Section Heading & Description (Frame 432) -->
  <div class="finished-standard__header">
    <h2 class="finished-standard__title">
      Premium Means Finished Details, Not Left for Later
    </h2>
    <p class="finished-standard__desc">
      Premium is not a label. It is the layout, materials, kitchen, bathrooms, lighting, exterior work, and how those decisions fit together.
    </p>
  </div>

  <!-- Full-Width Interactive Showcase Box (Frame 455) -->
  <div class="finished-standard__showcase" id="fs-showcase">
    <!-- Background Ambient Layers (Active item cross-fade) -->
    <div class="finished-standard__bg-layers" aria-hidden="true">
      {showcaseItems.map((item, idx) => (
        <div
          class:list={[
            'finished-standard__bg-item',
            { 'finished-standard__bg-item--active': item.active }
          ]}
          data-bg-index={idx}
        >
          <img
            src={item.image}
            alt=""
            class="finished-standard__bg-img"
            loading="lazy"
          />
        </div>
      ))}
      <div class="finished-standard__bg-overlay"></div>
    </div>


    <!-- Center Display Title & Description (Frame 456) -->
    <div class="finished-standard__center-info" id="fs-center-info">
      <h3 class="finished-standard__center-title" id="fs-center-title" set:html={showcaseItems[0].title} />
      <p class="finished-standard__center-desc" id="fs-center-desc">
        {showcaseItems[0].subtitle}
      </p>
    </div>

    <!-- Bottom Thumbnail Navigation Bar (Frame 463 / Frame 464) -->
    <div class="finished-standard__nav-wrapper">
      <div class="finished-standard__nav-line" aria-hidden="true"></div>

      <div class="finished-standard__nav-cards" id="fs-cards" role="tablist" aria-label="Showcase items">
        {showcaseItems.map((item, idx) => (
          <button
            type="button"
            role="tab"
            class:list={[
              'finished-standard__card',
              { 'finished-standard__card--active': item.active }
            ]}
            data-index={idx}
            data-title={item.title}
            data-desc={item.subtitle}
            aria-selected={item.active ? 'true' : 'false'}
            aria-label={`View ${item.cardTitle}`}
          >
            <span class="finished-standard__card-title">
              {item.cardTitle}
            </span>

            <div class="finished-standard__thumb-box">
              <img
                src={item.image}
                alt=""
                class="finished-standard__thumb-img"
                loading="lazy"
              />
              <div class="finished-standard__thumb-overlay"></div>

              <!-- Action Indicator Arrow Button (Figma node 166:2366) -->
              <div class="finished-standard__arrow-btn" aria-hidden="true">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 20 20"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  class="finished-standard__arrow-icon"
                >
                  <path
                    d="M6.9154 7.9829V14.4905L6.91609 15.0906H5.71594L5.71663 14.4905V6.53554L5.71594 5.93547L6.31602 5.93616H14.271L14.871 5.93547V7.13562L14.271 7.13493H7.76338L15.7819 15.1534L14.9339 16.0014L6.9154 7.9829Z"
                    fill="#131313"
                    transform="rotate(90 10 10)"
                  />
                </svg>
              </div>
            </div>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Interactive Showcase Controller: Card switching with auto-play, smooth transitions & light parallax
  const showcase = document.getElementById('fs-showcase');
  if (showcase) {
    const cards = Array.from(showcase.querySelectorAll<HTMLButtonElement>('.finished-standard__card'));
    const bgItems = Array.from(showcase.querySelectorAll<HTMLElement>('.finished-standard__bg-item'));
    const bgLayers = showcase.querySelector<HTMLElement>('.finished-standard__bg-layers');
    const centerInfo = document.getElementById('fs-center-info');
    const centerTitle = document.getElementById('fs-center-title');
    const centerDesc = document.getElementById('fs-center-desc');

    let currentIndex = 0;
    let isTransitioning = false;
    let autoplayTimer: ReturnType<typeof setInterval> | null = null;
    let cleanupPrevTimer: ReturnType<typeof setTimeout> | null = null;
    const AUTOPLAY_INTERVAL = 4800; // 4.8 seconds

    // 1. Silky Smooth Switching Controller (Seamless Layer Stacking + Continuous Ken Burns Zoom)
    function switchToIndex(nextIndex: number) {
      if (nextIndex === currentIndex || isTransitioning) return;
      isTransitioning = true;
      const prevIndex = currentIndex;
      currentIndex = nextIndex;

      // Update Cards active state & accessibility
      cards.forEach((card, i) => {
        const isActive = i === nextIndex;
        card.classList.toggle('finished-standard__card--active', isActive);
        card.setAttribute('aria-selected', String(isActive));
      });

      // Clear any pending cleanup
      if (cleanupPrevTimer) {
        clearTimeout(cleanupPrevTimer);
      }

      // Mark outgoing item as --prev so it stays at opacity: 1 underneath at z-index: 2
      bgItems.forEach((bg) => bg.classList.remove('finished-standard__bg-item--prev'));
      if (bgItems[prevIndex]) {
        bgItems[prevIndex].classList.remove('finished-standard__bg-item--active');
        bgItems[prevIndex].classList.add('finished-standard__bg-item--prev');
      }

      // Activate incoming item (fades in on top at z-index: 3 and restarts Ken Burns zoom from scale 1)
      if (bgItems[nextIndex]) {
        const nextImg = bgItems[nextIndex].querySelector<HTMLElement>('.finished-standard__bg-img');
        if (nextImg) {
          nextImg.style.animation = 'none';
          void nextImg.offsetHeight; // trigger reflow
          nextImg.style.animation = '';
        }
        bgItems[nextIndex].classList.add('finished-standard__bg-item--active');
      }

      // Remove --prev from old item once incoming item is completely opaque (1400ms)
      cleanupPrevTimer = setTimeout(() => {
        bgItems.forEach((bg) => bg.classList.remove('finished-standard__bg-item--prev'));
      }, 1400);

      // Smooth fade out and update title & description
      const targetCard = cards[nextIndex];
      const newTitle = targetCard.dataset.title;
      const newDesc = targetCard.dataset.desc;

      if (centerTitle && centerDesc && newTitle && newDesc) {
        // Pure opacity fade with zero layout jump or translateY bounce
        centerTitle.style.opacity = '0';
        centerDesc.style.opacity = '0';

        setTimeout(() => {
          centerTitle.innerHTML = newTitle;
          centerDesc.textContent = newDesc;
          centerTitle.style.opacity = '1';
          centerDesc.style.opacity = '1';

          setTimeout(() => {
            isTransitioning = false;
          }, 350);
        }, 260);
      } else {
        isTransitioning = false;
      }
    }

    // 2. Autoplay Timer
    function startAutoplay() {
      stopAutoplay();
      autoplayTimer = setInterval(() => {
        const nextIndex = (currentIndex + 1) % cards.length;
        switchToIndex(nextIndex);
      }, AUTOPLAY_INTERVAL);
    }

    function stopAutoplay() {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    // Manual card click: switches to clicked photo and restarts auto-play countdown
    cards.forEach((card, idx) => {
      card.addEventListener('click', () => {
        switchToIndex(idx);
        startAutoplay();
      });
    });

    // Start auto-play on initial load
    startAutoplay();

    // 3. Subtle Parallax Effect on Scroll
    let ticking = false;

    function updateParallax() {
      const rect = showcase.getBoundingClientRect();
      const windowHeight = window.innerHeight;

      if (rect.bottom > 0 && rect.top < windowHeight) {
        const centerY = rect.top + rect.height / 2;
        const distFromCenter = centerY - windowHeight / 2;

        // Subtle vertical parallax offsets
        const bgOffset = -distFromCenter * 0.12;
        const textOffset = -distFromCenter * 0.04;

        if (bgLayers) {
          bgLayers.style.transform = `translate3d(0, ${bgOffset.toFixed(2)}px, 0)`;
        }
        if (centerInfo) {
          centerInfo.style.transform = `translate3d(-50%, ${textOffset.toFixed(2)}px, 0)`;
        }
      }
      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(updateParallax);
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    updateParallax();
  }
</script>

