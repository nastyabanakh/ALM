---
/**
 * SinglePointContactSection.astro
 * Section 04: Single point of contact (Figma node 125:685 / Frame 435)
 * "ONE BUILDER. ZERO CONTRACTOR CHAOS."
 * Includes responsive layout, fluid REM scaling, and interactive accordion.
 */

interface AccordionItem {
  id: string;
  num: string;
  title: string;
  shortTitle: string;
  description: string;
  image: string;
  active?: boolean;
}

const accordionItems: AccordionItem[] = [
  {
    id: 'accordion-01',
    num: '01//',
    title: 'PLANS &\nENGINEERING',
    shortTitle: 'Plans & Engineering',
    description: 'Use your existing plans or bring in the local architects and engineers needed to adapt them.',
    image: '/assets/section-04/plans-engineering.webp',
    active: true
  },
  {
    id: 'accordion-02',
    num: '02//',
    title: 'PERMITS &\nCITY REVIEWS',
    shortTitle: 'Permits & city reviews',
    description: 'ALM coordinates directly with local building departments, managing plan submissions, zoning approvals, and permit issuance.',
    image: '/assets/section-04/permits-city-reviews.webp',
    active: false
  },
  {
    id: 'accordion-03',
    num: '03//',
    title: 'CONTRACTORS &\nCONSTRUCTION',
    shortTitle: 'Contractors & construction',
    description: 'A single dedicated team oversees site work, trade contractors, material deliveries, and schedule adherence from groundbreak to finish.',
    image: '/assets/section-04/contractors-construction.webp',
    active: false
  },
  {
    id: 'accordion-04',
    num: '04//',
    title: 'INSPECTIONS &\nCLOSEOUT',
    shortTitle: 'Inspections & closeout',
    description: 'We schedule and walk all required municipal inspections, resolve punch lists, and deliver a clean, move-in ready home.',
    image: '/assets/section-04/inspections-closeout.webp',
    active: false
  }
];
---

<section class="spc-section" id="single-point-of-contact" aria-label="Single Point of Contact">
  <!-- Top Sub-Header Bar (Figma Frame 433) -->
  <div class="spc-section__bar">
    <div class="spc-section__bar-left">
      <span class="spc-section__bullet" aria-hidden="true"></span>
      <span class="spc-section__bar-title text-s text-opacity-subtle">
        Single point of contact
      </span>
    </div>
    <span class="spc-section__bar-index text-s text-opacity-subtle" aria-hidden="true">
      04//
    </span>
  </div>

  <div class="spc-section__divider" aria-hidden="true"></div>

  <!-- Main Display Title (node 125:696) -->
  <div class="spc-section__title-wrapper">
    <h2 class="spc-section__title">
      <span class="spc-section__title-row spc-section__title-row--1">
        <span>ONE</span>
        <span>BUILDER.ZERO</span>
      </span>
      <span class="spc-section__title-row spc-section__title-row--2">
        <span>CONTRACTOR</span>
        <span>CHAOS.</span>
      </span>
    </h2>
  </div>

  <!-- Centered Paragraph Description (node 125:697) -->
  <p class="spc-section__desc">
    ALM handles every permit, trade, and municipal inspection. You communicate strictly with one dedicated team.
  </p>

  <!-- Accordion List (node 125:702 - 125:747) -->
  <div class="spc-section__accordion" id="spc-accordion">
    {accordionItems.map((item, index) => (
      <article
        class={`spc-accordion__item ${item.active ? 'spc-accordion__item--active' : ''}`}
        data-index={index}
        id={item.id}
      >
        <!-- Background Image Container for Active State -->
        <div class="spc-accordion__bg" aria-hidden="true">
          <img src={item.image} alt="" class="spc-accordion__bg-img" loading="lazy" />
          <div class="spc-accordion__bg-overlay"></div>
        </div>

        <!-- Collapsed Header Trigger -->
        <button
          type="button"
          class="spc-accordion__header"
          aria-expanded={item.active ? 'true' : 'false'}
          aria-controls={`${item.id}-body`}
          data-accordion-trigger
        >
          <div class="spc-accordion__header-left">
            <span class="spc-accordion__index">{item.num}</span>
            <span class="spc-accordion__short-title">{item.shortTitle}</span>
          </div>
          <div class="spc-accordion__icon-box" aria-hidden="true">
            <span class="spc-accordion__icon spc-accordion__icon--plus">
              <svg width="27" height="28" viewBox="0 0 27 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M13.4896 0C13.7962 0 14.0903 0.126268 14.3072 0.351027C14.524 0.575786 14.6458 0.880625 14.6458 1.19848V12.7838H25.8229C26.1296 12.7838 26.4237 12.9101 26.6405 13.1348C26.8573 13.3596 26.9792 13.6644 26.9792 13.9823C26.9792 14.3002 26.8573 14.605 26.6405 14.8297C26.4237 15.0545 26.1296 15.1808 25.8229 15.1808H14.6458V26.7661C14.6458 27.084 14.524 27.3888 14.3072 27.6136C14.0903 27.8383 13.7962 27.9646 13.4896 27.9646C13.1829 27.9646 12.8888 27.8383 12.672 27.6136C12.4552 27.3888 12.3333 27.084 12.3333 26.7661V15.1808H1.15625C0.849593 15.1808 0.555497 15.0545 0.338658 14.8297C0.121819 14.605 0 14.3002 0 13.9823C0 13.6644 0.121819 13.3596 0.338658 13.1348C0.555497 12.9101 0.849593 12.7838 1.15625 12.7838H12.3333V1.19848C12.3333 0.880625 12.4552 0.575786 12.672 0.351027C12.8888 0.126268 13.1829 0 13.4896 0Z" fill="currentColor"/>
              </svg>
            </span>
            <span class="spc-accordion__icon spc-accordion__icon--minus">
              <svg width="37" height="37" viewBox="0 0 37 37" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M30.8332 17.3436H17.3436H6.1665C5.85985 17.3436 5.56575 17.4654 5.34891 17.6822C5.13207 17.8991 5.01025 18.1932 5.01025 18.4998C5.01025 18.8065 5.13207 19.1006 5.34891 19.3174C5.56575 19.5343 5.85985 19.6561 6.1665 19.6561H19.6561H30.8332C31.1398 19.6561 31.4339 19.5343 31.6508 19.3174C31.8676 19.1006 31.9894 18.8065 31.9894 18.4998C31.9894 18.1932 31.8676 17.8991 31.6508 17.6822C31.4339 17.4654 31.1398 17.3436 30.8332 17.3436Z" fill="currentColor"/>
              </svg>
            </span>
          </div>
        </button>

        <!-- Expanded Body Content -->
        <div class="spc-accordion__body" id={`${item.id}-body`}>
          <div class="spc-accordion__body-inner">
            <!-- Left Info Block -->
            <div class="spc-accordion__info">
              <h3 class="spc-accordion__expanded-title" set:html={item.title.replace('\n', '<br />')} />
              <div class="spc-accordion__desc-row">
                <p class="spc-accordion__expanded-desc">{item.description}</p>
                <div class="spc-accordion__dot" aria-hidden="true"></div>
              </div>
            </div>

            <!-- Right Preview Thumbnail -->
            <div class="spc-accordion__thumb-box">
              <img src={item.image} alt={item.shortTitle} class="spc-accordion__thumb-img" loading="lazy" />
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  // Interactive Accordion Controller with Synchronized Height Animation (Zero Layout Jump)
  const accordionContainer = document.getElementById('spc-accordion');
  if (accordionContainer) {
    const items = accordionContainer.querySelectorAll<HTMLElement>('.spc-accordion__item');
    let isTransitioning = false;

    items.forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>('[data-accordion-trigger]');
      if (!trigger) return;

      trigger.addEventListener('click', () => {
        const isCurrentlyActive = item.classList.contains('spc-accordion__item--active');
        if (isCurrentlyActive || isTransitioning) return;
        isTransitioning = true;

        const currentActive = accordionContainer.querySelector<HTMLElement>('.spc-accordion__item.spc-accordion__item--active');
        const currentBody = currentActive?.querySelector<HTMLElement>('.spc-accordion__body');
        const newBody = item.querySelector<HTMLElement>('.spc-accordion__body');

        if (!newBody) {
          isTransitioning = false;
          return;
        }

        // 1. Capture current body height
        if (currentBody) {
          const currentH = currentBody.scrollHeight;
          currentBody.style.height = `${currentH}px`;
          currentBody.style.opacity = '1';
        }

        // 2. Measure target body height
        newBody.style.height = '0px';
        newBody.style.opacity = '0';
        const targetH = newBody.scrollHeight;

        // 3. Force browser reflow to register start heights
        void newBody.offsetHeight;

        // 4. Update aria & active classes
        if (currentActive) {
          currentActive.classList.remove('spc-accordion__item--active');
          const oldTrigger = currentActive.querySelector<HTMLButtonElement>('[data-accordion-trigger]');
          if (oldTrigger) oldTrigger.setAttribute('aria-expanded', 'false');
        }
        item.classList.add('spc-accordion__item--active');
        trigger.setAttribute('aria-expanded', 'true');

        // 5. Simultaneously animate opening and closing heights in lockstep
        requestAnimationFrame(() => {
          newBody.style.height = `${targetH}px`;
          newBody.style.opacity = '1';

          if (currentBody) {
            currentBody.style.height = '0px';
            currentBody.style.opacity = '0';
          }
        });

        // 6. Reset inline styles after transition completes
        setTimeout(() => {
          newBody.style.height = '';
          newBody.style.opacity = '';
          if (currentBody) {
            currentBody.style.height = '';
            currentBody.style.opacity = '';
          }
          isTransitioning = false;
        }, 460);
      });
    });
  }
</script>

