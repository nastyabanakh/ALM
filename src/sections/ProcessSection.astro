    border-left-width: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 77rem;
    margin-left: 0;
  }

  /* ----------------------------------------------------------
     Monumental Justified Headline (Syne Bold 103rem)
     ---------------------------------------------------------- */
  .process-section__heading-box {
    display: flex;
    flex-direction: column;
