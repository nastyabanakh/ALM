    height: 24rem;
    display: block;
    opacity: 0.25;
    transition: opacity 0.35s ease;
  }

  .process-step--hovered .process-step__icon,
  .process-step:hover .process-step__icon {
    opacity: 1;
  }

  .process-section__timeline-wrapper--hovered .process-step:not(.process-step--hovered) .process-step__icon {
    opacity: 0.12;
  }

  /* ----------------------------------------------------------
     Floating Image Preview Card (Absolute, attached to mouse)
     ---------------------------------------------------------- */
  .process-section__preview-card {
    position: absolute;
    right: 80rem;
    top: 80rem;
    width: 153rem;
    height: 193rem;
    border-top-left-radius: 11rem;
    border-top-right-radius: 11rem;
    border-bottom-right-radius: 11rem;
    border-bottom-left-radius: 11rem;
    overflow: hidden;
    background-color: #131313;
    pointer-events: none;
    z-index: 10;
    opacity: 0;
    will-change: transform, opacity;
    transition: opacity 0.3s ease;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .process-section__preview-card--visible {
