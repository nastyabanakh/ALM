  /* ----------------------------------------------------------
     Interactive 6-Step Timeline Container (Frame 478)
     ---------------------------------------------------------- */
  .process-section__timeline-wrapper {
    position: relative;
    width: 100%;
    display: flex;
    align-items: flex-start;
  }

  .process-section__list {
    display: flex;
