---
/**
 * BuilderAccountabilitySection.astro — Section 13: Builder Accountability
 * Figma node 213:1090 / Frame 500 / Spacer 207:934
 *
 * Requirements:
 * — Top gap: 120rem spacer (var(--space-l))
 * — Side padding: strictly 40rem (var(--gap-r))
 * — White background
 * — Sub-bar: Builder accountability / 13//
 * — Centered H2 title + description
 * — 4-column commitments grid with vertical & horizontal dividers
 * — Centered CTA button: "SCHEDULE A CONSULTATION"
 */
import ButtonComposite from '../components/ButtonComposite.astro';

interface CommitmentItem {
  titleLine1: string;
  titleLine2?: string;
  description: string;
}

const commitments: CommitmentItem[] = [
  {
    titleLine1: 'Defined',
    titleLine2: 'Project Scope',
    description: 'The signed contract lists the full scope of work, transparent payment milestones, project timelines, and clear build responsibilities.'
  },
  {
    titleLine1: 'Documented',
    titleLine2: 'Changes',
    description: 'If an adjustment affects cost, scope, or schedule, it is formally reviewed and signed off before any work begins.'
  },
  {
    titleLine1: 'Inspections',
    titleLine2: '& Closeout',
    description: 'Every required city inspection is scheduled, managed, and passed through to final permit completion and legal occupancy.'
  },
  {
    titleLine1: 'Builder',
    titleLine2: 'Warranty',
    description: 'Coverage details, timeframes, exclusions, and warranty claim procedures are fully defined in the signed agreement.'
  }
];
---

<section class="builder-accountability" id="builder-accountability" aria-label="Builder Accountability">
  <!-- Top 120rem Spacer -->
  <div class="builder-accountability__top-spacer" aria-hidden="true"></div>

  <div class="builder-accountability__container">

    <!-- 1. SUB-HEADER BAR -->
    <div class="builder-accountability__bar">
      <div class="builder-accountability__bar-main">
        <span class="builder-accountability__bullet" aria-hidden="true"></span>
        <span class="builder-accountability__bar-label text-m">Builder accountability</span>
      </div>
      <span class="builder-accountability__bar-index text-m">13//</span>
    </div>
    <div class="builder-accountability__divider" aria-hidden="true"></div>

    <!-- 2. SECTION HEADER (TITLE & DESCRIPTION) -->
    <div class="builder-accountability__header">
      <h2 class="builder-accountability__title h2">
        Clear Commitments in Writing: From Scope to Warranty
      </h2>
      <p class="builder-accountability__desc text-m">
        The agreement records what is included, how changes are approved, and which warranty terms apply.
      </p>
    </div>

    <!-- 3. 4-COLUMN COMMITMENTS GRID -->
    <div class="builder-accountability__grid-wrapper">
      <div class="builder-accountability__grid-top-line" aria-hidden="true"></div>

      <div class="builder-accountability__grid">
        {commitments.map((item, index) => (
          <div class="builder-accountability__col">
            {index > 0 && (
              <div class="builder-accountability__v-divider" aria-hidden="true"></div>
            )}
            <div class="builder-accountability__col-inner">
              <h3 class="builder-accountability__col-title">
                <span>{item.titleLine1}</span>
                {item.titleLine2 && <span>{item.titleLine2}</span>}
              </h3>
              <p class="builder-accountability__col-desc text-m">
                {item.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- 4. CENTERED CTA BUTTON -->
    <div class="builder-accountability__cta-wrap">
      <ButtonComposite
        text="SCHEDULE A CONSULTATION"
        href="#contact"
        variant="dark"
      />
    </div>

  </div>
</section>

<style>
  /* ============================================================
     BUILDER ACCOUNTABILITY — SECTION 13
     Fluid REM Scaling: 1px Figma = 1rem CSS. Zero-px rule.
     Atomic longhand box model & positioning properties only.
     ============================================================ */

  .builder-accountability {
    background-color: var(--bg-white);
    position: relative;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    overflow-x: clip;
  }

  /* ─── 120rem Top Spacer (Figma node 207:934 Space/S) ─── */
  .builder-accountability__top-spacer {
    width: 100%;
    height: 120rem;
    background-color: var(--bg-white);
  }

  .builder-accountability__container {
    width: 100%;
    max-width: 1440rem;
    margin-top: 0;
    margin-right: auto;
    margin-bottom: 0;
    margin-left: auto;
    padding-top: 0;
    padding-right: 40rem;
    padding-bottom: 0;
    padding-left: 40rem;
  }

  /* ─── 1. Sub-Header Bar ─── */
  .builder-accountability__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: var(--gap-2xs);
    padding-left: 0;
  }

  .builder-accountability__bar-main {
    display: flex;
    align-items: center;
    column-gap: 9rem;
  }

  .builder-accountability__bullet {
    display: block;
    width: 6rem;
    height: 6rem;
    background-color: var(--color-dark);
    flex-shrink: 0;
  }

  .builder-accountability__bar-label {
    color: var(--color-dark);
    opacity: 0.5;
  }

  .builder-accountability__bar-index {
    color: var(--color-dark);
    opacity: 0.5;
  }

  .builder-accountability__divider {
    width: 100%;
    height: 1rem;
    background-color: rgba(19, 19, 19, 0.15);
    margin-top: var(--gap-2xs);
    margin-right: 0;
    margin-bottom: 99rem;
    margin-left: 0;
  }

  /* ─── 2. Section Header (Title + Description) ─── */
  .builder-accountability__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-top: 0;
    margin-right: auto;
    margin-bottom: 99rem;
    margin-left: auto;
    max-width: 555rem;
    row-gap: 19rem;
  }

  .builder-accountability__title {
    color: var(--color-dark);
    text-transform: uppercase;
    line-height: 1.1;
  }

  .builder-accountability__desc {
    color: var(--color-dark);
    opacity: 0.5;
    line-height: 1.4;
    max-width: 291rem;
  }

  /* ─── 3. 4-Column Commitments Grid ─── */
  .builder-accountability__grid-wrapper {
    width: 100%;
    position: relative;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 70rem;
    margin-left: 0;
  }

  .builder-accountability__grid-top-line {
    width: 100%;
    height: 1rem;
    background-color: rgba(19, 19, 19, 0.15);
  }

  .builder-accountability__grid {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    width: 100%;
    padding-top: 24rem;
    padding-right: 0;
    padding-bottom: 24rem;
    padding-left: 0;
  }

  .builder-accountability__col {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: row;
    position: relative;
  }

  .builder-accountability__v-divider {
    width: 1rem;
    background-color: rgba(19, 19, 19, 0.15);
    flex-shrink: 0;
    margin-top: -24rem;
    margin-bottom: -24rem;
  }

  .builder-accountability__col-inner {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    row-gap: 58rem;
    padding-top: 0;
    padding-right: 28rem;
    padding-bottom: 0;
    padding-left: 28rem;
  }

  .builder-accountability__col:first-child .builder-accountability__col-inner {
    padding-left: 0;
  }

  .builder-accountability__col:last-child .builder-accountability__col-inner {
    padding-right: 0;
  }

  .builder-accountability__col-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 24rem;
    line-height: 1.15;
    text-transform: uppercase;
    color: var(--color-dark);
    display: flex;
    flex-direction: column;
  }

  .builder-accountability__col-desc {
    color: var(--color-dark);
    opacity: 0.5;
    line-height: 1.4;
    max-width: 292rem;
  }

  /* ─── 4. Centered CTA Button ─── */
  .builder-accountability__cta-wrap {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: 0;
    margin-right: auto;
    margin-bottom: 0;
    margin-left: auto;
  }

  /* ─── MOBILE ADAPTATION (max-width: 479px) ─── */
  @media (max-width: 479px) {
    .builder-accountability {
      padding-bottom: var(--gap-xl);
    }

    .builder-accountability__top-spacer {
      height: 60rem;
    }

    .builder-accountability__container {
      padding-right: var(--gap-p);
      padding-left: var(--gap-p);
    }

    .builder-accountability__divider {
      margin-bottom: var(--gap-l);
    }

    .builder-accountability__header {
      align-items: flex-start;
      text-align: left;
      margin-bottom: var(--gap-l);
      max-width: 100%;
    }

    .builder-accountability__desc {
      max-width: 100%;
    }

    .builder-accountability__grid {
      flex-direction: column;
      row-gap: var(--gap-l);
      padding-top: var(--gap-m);
      padding-bottom: var(--gap-m);
    }

    .builder-accountability__v-divider {
      display: none;
    }

    .builder-accountability__col-inner {
      padding-left: 0;
      padding-right: 0;
      row-gap: var(--gap-s);
      border-bottom-width: 1rem;
      border-bottom-style: solid;
      border-bottom-color: rgba(19, 19, 19, 0.1);
      padding-bottom: var(--gap-m);
    }

    .builder-accountability__col:last-child .builder-accountability__col-inner {
      border-bottom-width: 0;
      padding-bottom: 0;
    }

    .builder-accountability__col-title {
      font-size: 20rem;
    }

    .builder-accountability__col-desc {
      max-width: 100%;
    }

    .builder-accountability__cta-wrap {
      width: 100%;
    }
  }
</style>
