---
/**
 * FinalCtaFormSection.astro — Section 15: Start the conversation
 * Figma node 216:1678 / Frame 216:1678 & 2-Step Consultation Flow
 *
 * Requirements:
 * — Dark background (#131313 with dot pattern)
 * — Top & bottom spacers: 120rem (var(--space-l))
 * — Side padding: strictly 40rem (var(--gap-r))
 * — Sub-bar: Start the conversation / 15//
 * — Centered H2 title + description
 * — Left column (675rem):
 *     - Step 1: Required fields (Name, Email, Phone, Location, Starting point, Project message) -> NEXT STEP
 *     - Step 2: Optional project details (Existing home, Home size, Architectural style, Budget, Timeline, Plans status) -> SCHEDULE A CONSULTATION
 *     - Compact vertical gaps between fields (24-26rem)
 * — Right column (562rem): 3 specification lines + Large full-height Patio photo
 * — Fluid REM Scaling & Longhand CSS box model
 */
import ButtonComposite from '../components/ButtonComposite.astro';
const cmsContent = (Astro.props as any).content;
---

<section data-cms-section="finalCtaForm" class="start-conversation" id="contact" aria-label="Start the conversation">
  <!-- Top 120rem Spacer -->
  <div class="start-conversation__top-spacer" aria-hidden="true"></div>

  <div class="start-conversation__container">

    <!-- 1. SUB-HEADER BAR -->
    <div class="start-conversation__bar">
      <div class="start-conversation__bar-main">
        <span class="start-conversation__bullet" aria-hidden="true"></span>
        <span class="start-conversation__bar-label text-m" data-cms-path="sections.finalCtaForm.barLabel">{cmsContent.sections.finalCtaForm.barLabel}</span>
      </div>
      <span class="start-conversation__bar-index text-m" data-cms-path="sections.finalCtaForm.barIndex">{cmsContent.sections.finalCtaForm.barIndex}</span>
    </div>
    <div class="start-conversation__divider" aria-hidden="true"></div>

    <!-- 2. SECTION HEADER (TITLE & DESCRIPTION) -->
    <div class="start-conversation__header">
      <h2 class="start-conversation__title h2" data-cms-path="sections.finalCtaForm.title">
        {cmsContent.sections.finalCtaForm.title}
      </h2>
      <p class="start-conversation__desc text-m" data-cms-path="sections.finalCtaForm.desc">
        {cmsContent.sections.finalCtaForm.desc}
      </p>
    </div>

    <!-- 3. TWO-COLUMN LAYOUT -->
    <div class="start-conversation__layout">

      <!-- LEFT COLUMN: 2-STEP INTERACTIVE FORM -->
      <div class="start-conversation__col-left">

        <form class="start-conversation__form" id="consultation-flow-form" novalidate>

          <!-- ─── STEP 1: REQUIRED FIELDS ─── -->
          <div class="start-conversation__step is-active" id="flow-step-1">
            <div class="start-conversation__form-header">
              <div class="start-conversation__form-titles">
                <h3 class="start-conversation__step-title" data-cms-path="sections.finalCtaForm.stepTitle">
                  {cmsContent.sections.finalCtaForm.stepTitle}
                </h3>
                <p class="start-conversation__step-desc text-m" data-cms-path="sections.finalCtaForm.stepDesc">
                  {cmsContent.sections.finalCtaForm.stepDesc}
                </p>
              </div>
              <span class="start-conversation__step-bullet" aria-hidden="true"></span>
            </div>

            <div class="start-conversation__fields">
              <!-- Field: Name -->
              <div class="start-conversation__field">
                <label for="flow-name" class="start-conversation__label" data-cms-path="sections.finalCtaForm.label">{cmsContent.sections.finalCtaForm.label}</label>
                <input
                  type="text"
                  id="flow-name"
                  name="name"
                  class="start-conversation__input"
                  placeholder={cmsContent.sections.finalCtaForm.inputPlaceholder}
                  required
                 data-cms-path-placeholder="sections.finalCtaForm.inputPlaceholder"/>
              </div>

              <!-- Field: Email -->
              <div class="start-conversation__field">
                <label for="flow-email" class="start-conversation__label" data-cms-path="sections.finalCtaForm.label2">{cmsContent.sections.finalCtaForm.label2}</label>
                <input
                  type="email"
                  id="flow-email"
                  name="email"
                  class="start-conversation__input"
                  placeholder={cmsContent.sections.finalCtaForm.inputPlaceholder2}
                  required
                 data-cms-path-placeholder="sections.finalCtaForm.inputPlaceholder2"/>
              </div>

              <!-- Field: Phone -->
              <div class="start-conversation__field">
                <label for="flow-phone" class="start-conversation__label" data-cms-path="sections.finalCtaForm.label3">{cmsContent.sections.finalCtaForm.label3}</label>
                <input
                  type="tel"
                  id="flow-phone"
                  name="phone"
                  class="start-conversation__input"
                  placeholder={cmsContent.sections.finalCtaForm.inputPlaceholder3}
                  required
                 data-cms-path-placeholder="sections.finalCtaForm.inputPlaceholder3"/>
              </div>

              <!-- Field: Preferred Project Location -->
              <div class="start-conversation__field">
                <label for="flow-location" class="start-conversation__label" data-cms-path="sections.finalCtaForm.label4">{cmsContent.sections.finalCtaForm.label4}</label>
                <input
                  type="text"
                  id="flow-location"
                  name="location"
                  class="start-conversation__input"
                  placeholder={cmsContent.sections.finalCtaForm.inputPlaceholder4}
                  required
                 data-cms-path-placeholder="sections.finalCtaForm.inputPlaceholder4"/>
              </div>

              <!-- Field: Where are you starting? -->
              <div class="start-conversation__field">
                <label for="flow-starting-point" class="start-conversation__label" data-cms-path="sections.finalCtaForm.label5">{cmsContent.sections.finalCtaForm.label5}</label>
                <div class="start-conversation__select-wrapper">
                  <select id="flow-starting-point" name="startingPoint" class="start-conversation__select" required>
                    <option value="" disabled selected data-cms-path="sections.finalCtaForm.option">{cmsContent.sections.finalCtaForm.option}</option>
                    <option value="looking-for-property" data-cms-path="sections.finalCtaForm.option2">{cmsContent.sections.finalCtaForm.option2}</option>
                    <option value="own-vacant-lot" data-cms-path="sections.finalCtaForm.option3">{cmsContent.sections.finalCtaForm.option3}</option>
                    <option value="own-teardown-home" data-cms-path="sections.finalCtaForm.option4">{cmsContent.sections.finalCtaForm.option4}</option>
                    <option value="have-plans" data-cms-path="sections.finalCtaForm.option5">{cmsContent.sections.finalCtaForm.option5}</option>
                    <option value="have-reference" data-cms-path="sections.finalCtaForm.option6">{cmsContent.sections.finalCtaForm.option6}</option>
                    <option value="other" data-cms-path="sections.finalCtaForm.option7">{cmsContent.sections.finalCtaForm.option7}</option>
                  </select>
                  <span class="start-conversation__select-arrow" aria-hidden="true"></span>
                </div>
              </div>

              <!-- Field: Project Message -->
              <div class="start-conversation__field">
                <label for="flow-message" class="start-conversation__label" data-cms-path="sections.finalCtaForm.label6">{cmsContent.sections.finalCtaForm.label6}</label>
                <input
                  type="text"
                  id="flow-message"
                  name="message"
                  class="start-conversation__input"
                  placeholder={cmsContent.sections.finalCtaForm.inputPlaceholder5}
                 data-cms-path-placeholder="sections.finalCtaForm.inputPlaceholder5"/>
              </div>
            </div>

            <!-- Next Step Action -->
            <div class="start-conversation__btn-wrap">
              <ButtonComposite
                text={cmsContent.sections.finalCtaForm.nextStepButtonText}
                cmsTextPath="sections.finalCtaForm.nextStepButtonText"
                variant="white"
                fullWidth={true}
                as="button"
                type="button"
                id="flow-next-btn"
              />
            </div>
          </div>

          <!-- ─── STEP 2: OPTIONAL PROJECT DETAILS ─── -->
          <div class="start-conversation__step" id="flow-step-2">
            <div class="start-conversation__form-header">
              <div class="start-conversation__form-titles">
                <h3 class="start-conversation__step-title" data-cms-path="sections.finalCtaForm.stepTitle2">
                  {cmsContent.sections.finalCtaForm.stepTitle2}
                </h3>
                <p class="start-conversation__step-desc text-m" data-cms-path="sections.finalCtaForm.stepDesc2">
                  {cmsContent.sections.finalCtaForm.stepDesc2}
                </p>
              </div>
              <span class="start-conversation__step-bullet" aria-hidden="true"></span>
            </div>

            <div class="start-conversation__fields">
              <!-- Field: Existing home on property? -->
              <div class="start-conversation__field">
                <label for="flow-existing-home" class="start-conversation__label" data-cms-path="sections.finalCtaForm.label7">{cmsContent.sections.finalCtaForm.label7}</label>
                <div class="start-conversation__select-wrapper">
                  <select id="flow-existing-home" name="existingHome" class="start-conversation__select">
                    <option value="" disabled selected data-cms-path="sections.finalCtaForm.option8">{cmsContent.sections.finalCtaForm.option8}</option>
                    <option value="yes" data-cms-path="sections.finalCtaForm.option9">{cmsContent.sections.finalCtaForm.option9}</option>
                    <option value="no" data-cms-path="sections.finalCtaForm.option10">{cmsContent.sections.finalCtaForm.option10}</option>
                    <option value="not-sure" data-cms-path="sections.finalCtaForm.option11">{cmsContent.sections.finalCtaForm.option11}</option>
                    <option value="no-property-yet" data-cms-path="sections.finalCtaForm.option12">{cmsContent.sections.finalCtaForm.option12}</option>
                  </select>
                  <span class="start-conversation__select-arrow" aria-hidden="true"></span>
                </div>
              </div>

              <!-- Field: Approximate Home Size -->
              <div class="start-conversation__field">
                <label for="flow-home-size" class="start-conversation__label" data-cms-path="sections.finalCtaForm.label8">{cmsContent.sections.finalCtaForm.label8}</label>
                <input
                  type="text"
                  id="flow-home-size"
                  name="homeSize"
                  class="start-conversation__input"
                  placeholder={cmsContent.sections.finalCtaForm.inputPlaceholder6}
                 data-cms-path-placeholder="sections.finalCtaForm.inputPlaceholder6"/>
              </div>

              <!-- Field: Architectural Style -->
              <div class="start-conversation__field">
                <label for="flow-arch-style" class="start-conversation__label" data-cms-path="sections.finalCtaForm.label9">{cmsContent.sections.finalCtaForm.label9}</label>
                <input
                  type="text"
                  id="flow-arch-style"
                  name="architecturalStyle"
                  class="start-conversation__input"
                  placeholder={cmsContent.sections.finalCtaForm.inputPlaceholder7}
                 data-cms-path-placeholder="sections.finalCtaForm.inputPlaceholder7"/>
              </div>

              <!-- Field: Estimated Budget -->
              <div class="start-conversation__field">
                <label for="flow-budget" class="start-conversation__label" data-cms-path="sections.finalCtaForm.label10">{cmsContent.sections.finalCtaForm.label10}</label>
                <div class="start-conversation__select-wrapper">
                  <select id="flow-budget" name="budget" class="start-conversation__select">
                    <option value="" disabled selected data-cms-path="sections.finalCtaForm.option13">{cmsContent.sections.finalCtaForm.option13}</option>
                    <option value="under-1-5m" data-cms-path="sections.finalCtaForm.option14">{cmsContent.sections.finalCtaForm.option14}</option>
                    <option value="1-5m-2-5m" data-cms-path="sections.finalCtaForm.option15">{cmsContent.sections.finalCtaForm.option15}</option>
                    <option value="2-5m-plus" data-cms-path="sections.finalCtaForm.option16">{cmsContent.sections.finalCtaForm.option16}</option>
                    <option value="prefer-to-discuss" data-cms-path="sections.finalCtaForm.option17">{cmsContent.sections.finalCtaForm.option17}</option>
                    <option value="not-sure-yet" data-cms-path="sections.finalCtaForm.option18">{cmsContent.sections.finalCtaForm.option18}</option>
                  </select>
                  <span class="start-conversation__select-arrow" aria-hidden="true"></span>
                </div>
              </div>

              <!-- Field: Desired Timeline -->
              <div class="start-conversation__field">
                <label for="flow-timeline" class="start-conversation__label" data-cms-path="sections.finalCtaForm.label11">{cmsContent.sections.finalCtaForm.label11}</label>
                <div class="start-conversation__select-wrapper">
                  <select id="flow-timeline" name="timeline" class="start-conversation__select">
                    <option value="" disabled selected data-cms-path="sections.finalCtaForm.option19">{cmsContent.sections.finalCtaForm.option19}</option>
                    <option value="exploring" data-cms-path="sections.finalCtaForm.option20">{cmsContent.sections.finalCtaForm.option20}</option>
                    <option value="planning-soon" data-cms-path="sections.finalCtaForm.option21">{cmsContent.sections.finalCtaForm.option21}</option>
                    <option value="target-start-date" data-cms-path="sections.finalCtaForm.option22">{cmsContent.sections.finalCtaForm.option22}</option>
                    <option value="not-sure-yet" data-cms-path="sections.finalCtaForm.option23">{cmsContent.sections.finalCtaForm.option23}</option>
                  </select>
                  <span class="start-conversation__select-arrow" aria-hidden="true"></span>
                </div>
              </div>

              <!-- Field: Plans Status -->
              <div class="start-conversation__field">
                <label for="flow-plans-status" class="start-conversation__label" data-cms-path="sections.finalCtaForm.label12">{cmsContent.sections.finalCtaForm.label12}</label>
                <div class="start-conversation__select-wrapper">
                  <select id="flow-plans-status" name="plansStatus" class="start-conversation__select">
                    <option value="" disabled selected data-cms-path="sections.finalCtaForm.option24">{cmsContent.sections.finalCtaForm.option24}</option>
                    <option value="completed" data-cms-path="sections.finalCtaForm.option25">{cmsContent.sections.finalCtaForm.option25}</option>
                    <option value="preliminary" data-cms-path="sections.finalCtaForm.option26">{cmsContent.sections.finalCtaForm.option26}</option>
                    <option value="in-development" data-cms-path="sections.finalCtaForm.option27">{cmsContent.sections.finalCtaForm.option27}</option>
                    <option value="no-plans" data-cms-path="sections.finalCtaForm.option28">{cmsContent.sections.finalCtaForm.option28}</option>
                    <option value="reference-only" data-cms-path="sections.finalCtaForm.option29">{cmsContent.sections.finalCtaForm.option29}</option>
                  </select>
                  <span class="start-conversation__select-arrow" aria-hidden="true"></span>
                </div>
              </div>
            </div>

            <!-- Step 2 Actions (Back & Submit) -->
            <div class="start-conversation__step-actions">
              <button type="button" class="start-conversation__back-btn" id="flow-back-btn" data-cms-path="sections.finalCtaForm.backBtn">
                {cmsContent.sections.finalCtaForm.backBtn}
              </button>
              <ButtonComposite
                text={cmsContent.sections.finalCtaForm.submitButtonText}
                cmsTextPath="sections.finalCtaForm.submitButtonText"
                variant="white"
                fullWidth={true}
                as="button"
                type="submit"
                id="flow-submit-btn"
              />
            </div>
          </div>

          <!-- ─── SUCCESS ALERT CARD ─── -->
          <div class="start-conversation__success-box" id="flow-success-box" role="alert">
            <p class="start-conversation__success-title" data-cms-path="sections.finalCtaForm.successTitle">{cmsContent.sections.finalCtaForm.successTitle}</p>
            <p class="start-conversation__success-text text-m" data-cms-path="sections.finalCtaForm.successText">
              {cmsContent.sections.finalCtaForm.successText}
            </p>
          </div>

        </form>
      </div>

      <!-- RIGHT COLUMN: SPECS + ENLARGED PHOTO -->
      <div class="start-conversation__col-right">

        <!-- 3 Specification Lines -->
        <div class="start-conversation__specs">
          <div class="start-conversation__spec-row">
            <div class="start-conversation__spec-inner">
              <span class="start-conversation__spec-label" data-cms-path="sections.finalCtaForm.specLabel">{cmsContent.sections.finalCtaForm.specLabel}</span>
              <span class="start-conversation__spec-value" data-cms-path="sections.finalCtaForm.specValue">{cmsContent.sections.finalCtaForm.specValue}</span>
            </div>
            <div class="start-conversation__spec-line" aria-hidden="true"></div>
          </div>

          <div class="start-conversation__spec-row">
            <div class="start-conversation__spec-inner">
              <span class="start-conversation__spec-label" data-cms-path="sections.finalCtaForm.specLabel2">{cmsContent.sections.finalCtaForm.specLabel2}</span>
              <span class="start-conversation__spec-value" data-cms-path="sections.finalCtaForm.specValue2">{cmsContent.sections.finalCtaForm.specValue2}</span>
            </div>
            <div class="start-conversation__spec-line" aria-hidden="true"></div>
          </div>

          <div class="start-conversation__spec-row">
            <div class="start-conversation__spec-inner">
              <span class="start-conversation__spec-label" data-cms-path="sections.finalCtaForm.specLabel3">{cmsContent.sections.finalCtaForm.specLabel3}</span>
              <span class="start-conversation__spec-value" data-cms-path="sections.finalCtaForm.specValue3">{cmsContent.sections.finalCtaForm.specValue3}</span>
            </div>
            <div class="start-conversation__spec-line" aria-hidden="true"></div>
          </div>
        </div>

        <!-- Large Photo Box -->
        <div class="start-conversation__photo-box">
          <img
            src={cmsContent.sections.finalCtaForm.photoSrc}
            alt={cmsContent.sections.finalCtaForm.photoAlt}
            class="start-conversation__photo"
            loading="lazy"
            decoding="async"
           data-cms-path-src="sections.finalCtaForm.photoSrc" data-cms-path-alt="sections.finalCtaForm.photoAlt"/>
        </div>

      </div>

    </div>

  </div>

  <!-- Bottom 120rem Spacer -->
  <div class="start-conversation__bottom-spacer" aria-hidden="true"></div>
</section>

<script>
  function initFlowForm() {
    const form = document.getElementById('consultation-flow-form') as HTMLFormElement | null;
    const step1 = document.getElementById('flow-step-1') as HTMLElement | null;
    const step2 = document.getElementById('flow-step-2') as HTMLElement | null;
    const nextBtn = document.getElementById('flow-next-btn') as HTMLElement | null;
    const backBtn = document.getElementById('flow-back-btn') as HTMLElement | null;
    const successBox = document.getElementById('flow-success-box') as HTMLElement | null;

    if (!form || !step1 || !step2 || !nextBtn || !backBtn || !successBox) return;

    // Step 1 -> Step 2 validation & transition
    nextBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();

      const step1Inputs = step1.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select');
      let isValid = true;

      step1Inputs.forEach((input) => {
        if (!input.checkValidity()) {
          input.reportValidity();
          isValid = false;
        }
      });

      if (isValid) {
        step1.classList.remove('is-active');
        step2.classList.add('is-active');
      }
    });

    // Step 2 -> Step 1 back navigation
    backBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();

      step2.classList.remove('is-active');
      step1.classList.add('is-active');
    });

    // Form Submit
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      step1.classList.remove('is-active');
      step2.classList.remove('is-active');
      successBox.classList.add('is-visible');
      form.reset();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFlowForm);
  } else {
    initFlowForm();
  }
</script>

<style>
  /* ============================================================
     START THE CONVERSATION — SECTION 15
     Fluid REM Scaling: 1px Figma = 1rem CSS. Zero-px rule.
     Atomic longhand box model & positioning properties only.
     ============================================================ */

  .start-conversation {
    background-color: var(--bg-brand);
    background-image: var(--bg-pattern-dark);
    background-repeat: repeat;
    background-size: 30rem 30rem;
    background-attachment: scroll;
    position: relative;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    overflow-x: clip;
  }

  /* ─── 120rem Top & Bottom Spacer (Figma Space/S) ─── */
  .start-conversation__top-spacer,
  .start-conversation__bottom-spacer {
    width: 100%;
    height: 120rem;
  }

  .start-conversation__container {
    width: 100%;
    max-width: 1440rem;
    margin-top: 0;
    margin-right: auto;
    margin-bottom: 0;
    margin-left: auto;
    padding-top: 0;
    padding-right: 40rem;
    padding-bottom: 0;
    padding-left: 40rem;
  }

  /* ─── 1. Sub-Header Bar ─── */
  .start-conversation__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: var(--gap-2xs);
    padding-left: 0;
  }

  .start-conversation__bar-main {
    display: flex;
    align-items: center;
    column-gap: 9rem;
  }

  .start-conversation__bullet {
    display: block;
    width: 6rem;
    height: 6rem;
    background-color: var(--color-white);
    flex-shrink: 0;
  }

  .start-conversation__bar-label {
    color: var(--color-white);
    opacity: 0.5;
  }

  .start-conversation__bar-index {
    color: var(--color-white);
    opacity: 0.5;
  }

  .start-conversation__divider {
    width: 100%;
    height: 1rem;
    background-color: rgba(255, 255, 255, 0.15);
    margin-top: var(--gap-2xs);
    margin-right: 0;
    margin-bottom: 99rem;
    margin-left: 0;
  }

  /* ─── 2. Section Header (Title + Description) ─── */
  .start-conversation__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-top: 0;
    margin-right: auto;
    margin-bottom: 99rem;
    margin-left: auto;
    max-width: 633rem;
    row-gap: 19rem;
  }

  .start-conversation__title {
    color: var(--color-white);
    text-transform: uppercase;
    line-height: 1.05;
  }

  .start-conversation__desc {
    color: var(--color-white);
    opacity: 0.5;
    line-height: 1.4;
    max-width: 287rem;
  }

  /* ─── 3. Two-Column Layout ─── */
  .start-conversation__layout {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
    column-gap: 99rem;
    width: 100%;
  }

  /* Left Column: Form */
  .start-conversation__col-left {
    width: 675rem;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .start-conversation__form {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  /* Multi-Step Transitions */
  .start-conversation__step {
    display: none;
    flex-direction: column;
    width: 100%;
  }

  .start-conversation__step.is-active {
    display: flex;
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(6rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .start-conversation__form-header {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 56rem;
  }

  .start-conversation__form-titles {
    display: flex;
    flex-direction: column;
    row-gap: 9rem;
    max-width: 420rem;
  }

  .start-conversation__step-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 24rem;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--color-white);
  }

  .start-conversation__step-desc {
    color: var(--color-white);
    opacity: 0.5;
    line-height: 1.4;
  }

  .start-conversation__step-bullet {
    display: block;
    width: 6rem;
    height: 6rem;
    background-color: var(--color-white);
    flex-shrink: 0;
    margin-top: 6rem;
  }

  /* Compact Fields Vertical Spacing */
  .start-conversation__fields {
    display: flex;
    flex-direction: column;
    row-gap: 33rem;
    margin-bottom: 36rem;
    width: 100%;
  }

  .start-conversation__field {
