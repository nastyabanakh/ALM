---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  return (await getCollection('projects')).map(project => ({ params: { slug: project.data.slug }, props: { project } }));
}

const { project } = Astro.props;
---
<BaseLayout title={project.data.seo.title} description={project.data.seo.description}>
  <main class="cms-entry">
    <a href="/portfolio/">← Всі проєкти</a>
    <article>
      <h1>{project.data.title}</h1>
      <p>{project.data.summary}</p>
      {project.data.cover && <img src={project.data.cover.src} alt={project.data.cover.alt} />}
      {project.data.body && <p>{project.data.body}</p>}
      <div class="gallery">
        {project.data.gallery.map(image => <img src={image.src} alt={image.alt} />)}
      </div>
    </article>
  </main>
</BaseLayout>
<style>
  .cms-entry{max-width:960px;margin:auto;padding:80px 24px;min-height:70vh}
  article{margin-top:40px}
  h1{font-size:clamp(42px,7vw,84px);line-height:1.1}
  p{font-size:clamp(17px,2vw,22px);line-height:1.6}
  img{display:block;width:100%;height:auto;margin:32px 0}
  .gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
  .gallery img{margin:0}
  @media(max-width:640px){.gallery{grid-template-columns:1fr}}
</style>
