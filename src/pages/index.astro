---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import { HOME_PAGE_ID } from '../../cms/model.mjs';
import { resolveContentConstants } from '../../cms/constants.mjs';
import { listSitePages } from '../../cms/page-list.mjs';
import HeroSection from '../sections/HeroSection.astro';
import StartingPointsSection from '../sections/StartingPointsSection.astro';
import NewConstructionSection from '../sections/NewConstructionSection.astro';
import PropertyReviewSection from '../sections/PropertyReviewSection.astro';
import SinglePointContactSection from '../sections/SinglePointContactSection.astro';
import FinishedStandardSection from '../sections/FinishedStandardSection.astro';
import BudgetSelectionsSection from '../sections/BudgetSelectionsSection.astro';
import ProcessSection from '../sections/ProcessSection.astro';
import FeaturedHomeSection from '../sections/FeaturedHomeSection.astro';
import CompletedHomeSection from '../sections/CompletedHomeSection.astro';
import LocalManagementSection from '../sections/LocalManagementSection.astro';
import BuilderAccountabilitySection from '../sections/BuilderAccountabilitySection.astro';
import FaqSection from '../sections/FaqSection.astro';
import FinalCtaFormSection from '../sections/FinalCtaFormSection.astro';
import FooterSection from '../sections/FooterSection.astro';

const home = await getEntry('pages', HOME_PAGE_ID);
if (!home) throw new Error('Головну сторінку CMS не знайдено');
const content = resolveContentConstants(home.data.content, await listSitePages());
---

<BaseLayout
  title={content.meta.title}
  description={content.meta.description}
>
  <main>
    <HeroSection content={content} />
    <StartingPointsSection content={content} />
    <NewConstructionSection content={content} />
    <PropertyReviewSection content={content} />
    <SinglePointContactSection content={content} />
    <FinishedStandardSection content={content} />
    <BudgetSelectionsSection content={content} />
    <ProcessSection content={content} />
    <FeaturedHomeSection content={content} />
    <CompletedHomeSection content={content} />
    <LocalManagementSection content={content} />
    <BuilderAccountabilitySection content={content} />
    <FaqSection content={content} />
    <FinalCtaFormSection content={content} />
    <FooterSection content={content} />
  </main>
  <script is:inline src="/admin/preview-fields.js"></script>
</BaseLayout>
