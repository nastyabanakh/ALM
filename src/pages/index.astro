---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../sections/HeroSection.astro';
import StartingPointsSection from '../sections/StartingPointsSection.astro';
import NewConstructionSection from '../sections/NewConstructionSection.astro';
import PropertyReviewSection from '../sections/PropertyReviewSection.astro';
import SinglePointContactSection from '../sections/SinglePointContactSection.astro';
import FinishedStandardSection from '../sections/FinishedStandardSection.astro';
import BudgetSelectionsSection from '../sections/BudgetSelectionsSection.astro';
import ProcessSection from '../sections/ProcessSection.astro';
import FeaturedHomeSection from '../sections/FeaturedHomeSection.astro';
---

<BaseLayout
  title="ALM — Local, Family-Owned Custom Home Builder"
  description="Build the home you want—without managing the build yourself. Custom single-family new construction shaped around your property, plans, and priorities."
>
  <main>
    <HeroSection />
    <StartingPointsSection />
    <NewConstructionSection />
    <PropertyReviewSection />
    <SinglePointContactSection />
    <FinishedStandardSection />
    <BudgetSelectionsSection />
    <ProcessSection />
    <FeaturedHomeSection />
  </main>
</BaseLayout>
